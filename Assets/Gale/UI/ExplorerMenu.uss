/* Menú de exploración: barra lateral flotante y panel translúcido, al estilo de Google Earth (tema oscuro). */

.ex-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Barra de iconos ---------- */

.ex-rail {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 68px;
    padding: 8px 0 6px 0;
    align-items: center;
    background-color: rgba(32, 33, 36, 0.62);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.ex-item {
    width: 60px;
    height: 58px;
    margin: 2px 0;
    padding: 6px 0 4px 0;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ex-item:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.ex-item.selected {
    background-color: rgba(138, 180, 248, 0.24);
}

.ex-icon {
    width: 26px;
    height: 26px;
}

.ex-item-label {
    font-size: 11px;
    color: rgb(232, 234, 237);
    margin: 3px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.ex-item.selected .ex-item-label {
    color: rgb(138, 180, 248);
}

.ex-sep {
    width: 40px;
    height: 1px;
    margin: 6px 0;
    background-color: rgba(255, 255, 255, 0.12);
}

.ex-key {
    font-size: 10px;
    color: rgb(154, 160, 166);
    margin: 4px 0 0 0;
    -unity-text-align: middle-center;
}

/* ---------- Panel ---------- */

.ex-panel {
    position: absolute;
    left: 90px;
    top: 12px;
    bottom: 64px;
    width: 400px;
    background-color: rgba(32, 33, 36, 0.74);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 0;
}

.ex-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 10px 10px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.ex-title {
    flex-grow: 1;
    font-size: 20px;
    color: rgb(232, 234, 237);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.ex-close {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(232, 234, 237);
    font-size: 18px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.ex-close:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.ex-scroll {
    flex-grow: 1;
}

.ex-section {
    padding: 8px 18px 18px 18px;
}

.ex-heading {
    font-size: 12px;
    color: rgb(138, 180, 248);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 14px 0 6px 0;
    padding: 0;
}

.ex-text {
    font-size: 14px;
    color: rgb(232, 234, 237);
    white-space: normal;
    margin: 2px 0;
    padding: 0;
}

.ex-note {
    font-size: 12px;
    color: rgb(154, 160, 166);
    white-space: normal;
    margin: 4px 0 2px 0;
    padding: 0;
}

.ex-big {
    font-size: 26px;
    color: rgb(232, 234, 237);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* Fila etiqueta / valor */
.ex-kv {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.ex-k {
    font-size: 13px;
    color: rgb(154, 160, 166);
    margin: 0 10px 0 0;
    padding: 0;
    flex-shrink: 0;
}

.ex-v {
    font-size: 14px;
    color: rgb(232, 234, 237);
    -unity-text-align: upper-right;
    white-space: normal;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}

/* Lista de capas (radio) */
.ex-layer {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin: 2px 0;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.04);
}

.ex-layer:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.ex-layer.selected {
    background-color: rgba(138, 180, 248, 0.22);
}

.ex-radio {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(154, 160, 166);
    margin-right: 10px;
    flex-shrink: 0;
}

.ex-layer.selected .ex-radio {
    border-color: rgb(138, 180, 248);
    background-color: rgb(138, 180, 248);
}

.ex-layer-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.ex-layer-name {
    font-size: 14px;
    color: rgb(232, 234, 237);
    margin: 0;
    padding: 0;
}

.ex-layer-src {
    font-size: 11px;
    color: rgb(154, 160, 166);
    white-space: normal;
    margin: 1px 0 0 0;
    padding: 0;
}

.ex-swatches {
    flex-direction: row;
    margin-top: 4px;
}

.ex-swatch {
    width: 14px;
    height: 8px;
    margin-right: 2px;
    border-radius: 2px;
}

.ex-class {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
}

.ex-class-swatch {
    width: 18px;
    height: 12px;
    border-radius: 3px;
    margin-right: 8px;
    flex-shrink: 0;
}

.ex-class.current {
    background-color: rgba(138, 180, 248, 0.16);
    border-radius: 6px;
}

/* Interruptores */
.ex-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 9px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.ex-toggle-text {
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: 10px;
}

.ex-switch {
    width: 38px;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(154, 160, 166, 0.45);
    padding: 2px;
    flex-shrink: 0;
    flex-direction: row;
}

.ex-switch.on {
    background-color: rgba(138, 180, 248, 0.55);
    justify-content: flex-end;
}

.ex-knob {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(232, 234, 237);
}

.ex-switch.on .ex-knob {
    background-color: rgb(138, 180, 248);
}

.ex-slider {
    margin: 6px 0 0 0;
}

.ex-slider Label {
    color: rgb(232, 234, 237);
    font-size: 13px;
    min-width: 90px;
}

.ex-spark {
    height: 90px;
    margin: 8px 0 2px 0;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
}

.ex-badge {
    font-size: 11px;
    color: rgb(32, 33, 36);
    background-color: rgb(138, 180, 248);
    border-radius: 6px;
    padding: 1px 6px;
    margin: 0 0 0 6px;
    -unity-font-style: bold;
}

.ex-badge.model {
    background-color: rgb(253, 214, 99);
}

.ex-big {
    white-space: normal;
}

/* Barra de desplazamiento oscura y fina */
.ex-scroll .unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ex-scroll .unity-scroller__low-button,
.ex-scroll .unity-scroller__high-button {
    display: none;
}

.ex-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 4px;
}

.ex-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(232, 234, 237, 0.35);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
    left: 1px;
}

.ex-scroll .unity-scroller--vertical .unity-base-slider__drag-container {
    margin: 0;
}


/* ---------- Buscador ---------- */
.ex-search {
    margin: 4px 0 6px 0;
}

.ex-search > .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 15px;
    color: rgb(232, 234, 237);
    min-height: 36px;
}

.ex-search:focus > .unity-text-field__input {
    border-color: rgb(138, 180, 248);
}

/* ---------- Ventana del lugar (derecha) ---------- */
.ex-popup {
    position: absolute;
    right: 16px;
    top: 330px;
    bottom: 50px;
    width: 440px;
    background-color: rgba(32, 33, 36, 0.80);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
}

.ex-photo {
    height: 300px;
    flex-shrink: 0;
    border-radius: 10px;
    margin: 4px 0 4px 0;
    background-color: rgba(0, 0, 0, 0.3);
}

.ex-action {
    flex-grow: 1;
    height: 34px;
    margin: 0 6px 0 0;
    border-radius: 17px;
    border-width: 0;
    background-color: rgba(138, 180, 248, 0.25);
    color: rgb(232, 234, 237);
    font-size: 13px;
}

.ex-action:hover {
    background-color: rgba(138, 180, 248, 0.45);
}
